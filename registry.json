    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "admin-shell",
      "type": "registry:block",
      "title": "Admin shell",
      "description": "The admin's permanent frame: a header, a side navigation, and an empty work area. On a wide screen it's a sidebar with the section labels, on a narrow one an icon rail in its place and a burger in the header that opens a panel with the labels. Nav items are set through props and support icons and swapping the link render for your own router — in all three places. Requires the admin-theme theme.",
      "registryDependencies": ["sheet", "berezin-pavel/admin-kit/admin-theme"],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "registry/admin-shell/admin-shell.tsx",
          "type": "registry:component",
          "target": "@components/admin/admin-shell.tsx"
        },
        {
          "path": "registry/admin-shell/admin-header.tsx",
          "type": "registry:component",
          "target": "@components/admin/admin-header.tsx"
        },
        {
          "path": "registry/admin-shell/admin-nav.tsx",
          "type": "registry:component",
          "target": "@components/admin/admin-nav.tsx"
        },
        {
          "path": "registry/admin-shell/admin-rail.tsx",
          "type": "registry:component",
          "target": "@components/admin/admin-rail.tsx"
        },
        {
          "path": "registry/admin-shell/admin-menu.tsx",
          "type": "registry:component",
          "target": "@components/admin/admin-menu.tsx"
        }
      ]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "widget-metric",
      "type": "registry:component",
      "title": "Metric widget",
      "description": "A single-number card for a dashboard: title, value, an optional trend with an arrow, and a caption. Data is passed as props. Requires the admin-theme theme.",
      "registryDependencies": ["card", "berezin-pavel/admin-kit/admin-theme"],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "registry/widget-metric/widget-metric.tsx",
          "type": "registry:component",
          "target": "@components/admin/widget-metric.tsx"
        }
      ]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "widget-table",
      "type": "registry:component",
      "title": "Table widget",
      "description": "A table with a title and columns for a dashboard: columns and rows are passed as props, a column is right-aligned via the align prop, and for an empty set of rows it accepts a state of its own. Requires the admin-theme theme.",
      "registryDependencies": [
        "card",
        "table",
        "berezin-pavel/admin-kit/admin-theme"
      ],
      "files": [
        {
